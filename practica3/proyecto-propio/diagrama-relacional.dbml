// Código DBML para generar el Diagrama Relacional en https://dbdiagram.io
// Copia y pega este contenido en dbdiagram.io para exportar diagrama-relacional.png

Table paciente {
  nss varchar(15) [pk, not null]
  nombre varchar(120) [not null]
  estatus_vigencia boolean [not null, default: true]
  unidad_medica_adscripcion varchar(100) [not null]
  telefono varchar(15)
  nss_titular varchar(15)
}

Ref: paciente.nss_titular > paciente.nss

Table orden_medica {
  folio_orden varchar(20) [pk, not null]
  nss_paciente varchar(15) [not null]
  cedula_profesional varchar(20) [not null]
  fecha_cita_medico date [not null]
}

Ref: orden_medica.nss_paciente > paciente.nss

Table cita {
  id_cita serial [pk, not null]
  folio_orden varchar(20) [unique, not null]
  fecha_hora_agendamiento timestamptz [not null]
  fecha_hora_laboratorio timestamptz [not null]
  estatus_asistencia varchar(20) [not null, default: 'PROGRAMADA']
}

Ref: cita.folio_orden - orden_medica.folio_orden

Table estudio {
  id_estudio serial [pk, not null]
  nombre_estudio varchar(120) [unique, not null]
  indicaciones_previas text
  tipo_estudio varchar(20) [not null]
}

Table prueba_sangre {
  id_estudio int [pk, not null]
  tipo_tubo varchar(50) [not null]
  aditivo varchar(50) [not null]
  ayuno_horas int [not null, default: 8]
}

Ref: prueba_sangre.id_estudio - estudio.id_estudio

Table prueba_orina {
  id_estudio int [pk, not null]
  tipo_frasco varchar(50) [not null]
  volumen_min_ml numeric(5,2) [not null]
}

Ref: prueba_orina.id_estudio - estudio.id_estudio

Table prueba_fecal {
  id_estudio int [pk, not null]
  tipo_frasco varchar(50) [not null]
  requiere_medio_transporte boolean [not null, default: false]
}

Ref: prueba_fecal.id_estudio - estudio.id_estudio

Table orden_estudio {
  folio_orden varchar(20) [not null]
  id_estudio int [not null]
  indexes {
    (folio_orden, id_estudio) [pk]
  }
}

Ref: orden_estudio.folio_orden > orden_medica.folio_orden
Ref: orden_estudio.id_estudio > estudio.id_estudio

Table resultado {
  id_resultado serial [pk, not null]
  id_cita int [not null]
  tipo_prueba varchar(100) [not null]
  valor_obtenido varchar(100) [not null]
  unidad_medida varchar(30)
  observaciones text
  fecha_hora_emision timestamptz [not null]
}

Ref: resultado.id_cita > cita.id_cita
